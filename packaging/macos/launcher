#!/bin/sh
set -eu

case "$(uname -m)" in
    x86_64)
        payload_arch="x86_64"
        ;;
    arm64)
        payload_arch="arm64"
        ;;
    *)
        printf 'Social Auto Upload: unsupported macOS architecture: %s\n' "$(uname -m)" >&2
        exit 64
        ;;
esac

invocation_name=${0##*/}
launcher_path=$0
link_count=0
while [ -L "$launcher_path" ]; do
    link_count=$((link_count + 1))
    if [ "$link_count" -gt 32 ]; then
        printf 'Social Auto Upload: launcher symlink chain is too deep\n' >&2
        exit 66
    fi
    link_directory=$(CDPATH= cd -P -- "$(dirname -- "$launcher_path")" && pwd -P)
    link_target=$(readlink "$launcher_path") || {
        printf 'Social Auto Upload: cannot resolve launcher symlink: %s\n' "$launcher_path" >&2
        exit 66
    }
    case "$link_target" in
        /*) launcher_path=$link_target ;;
        *) launcher_path="${link_directory}/${link_target}" ;;
    esac
done

launcher_dir=$(CDPATH= cd -P -- "$(dirname -- "$launcher_path")" && pwd -P)
case "$invocation_name" in
    sau)
        entrypoint="sau"
        ;;
    *)
        entrypoint="SocialAutoUpload"
        ;;
esac

executable="${launcher_dir}/../Resources/payloads/${payload_arch}/${entrypoint}"
if [ ! -x "$executable" ]; then
    printf 'Social Auto Upload: native %s entry point is missing or not executable: %s\n' \
        "$payload_arch" "$executable" >&2
    exit 66
fi

exec "$executable" "$@"
